{
  "name": "leadg2-points",
  "version": "0.1.0",
  "private": true,
  "description": "LeadG2 service-point ledger, internal review queue, and client balance dashboard (pilot).",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/demo.js --no-serve",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.js",
    "demo:reviewed": "node --disable-warning=ExperimentalWarning scripts/demo.js --auto-review",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js"
  }
}
