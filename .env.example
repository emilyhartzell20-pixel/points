# Public HTTPS address of the app (used in invite and password-reset links). No trailing slash.
PUBLIC_URL=https://points.thecenterforsalesstrategy.com

# First admin, created once on first start. Their one-time setup link appears in `docker compose logs app`.
ADMIN_EMAIL=
ADMIN_NAME=

# Back up the database to /data/backups every 24 hours (keeps 30).
BACKUP_DAILY=1

# Optional: copy point balances onto linked HubSpot company records (private app token).
# HUBSPOT_PRIVATE_APP_TOKEN=

# --- Live connectors: leave commented out until LeadG2 is ready to connect real accounts. ---
# CONNECTOR_MODE=live
# CLICKUP_API_TOKEN=
# OUTLOOK_MAILBOX=
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# INTERNAL_EMAIL_DOMAINS=leadg2.com,thecenterforsalesstrategy.com
